# Optional: enables real AI summaries. If omitted, FinBrief uses its safe built-in fallback summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint:
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional persistent MySQL database. The default free deployment uses memory storage.
USE_DATABASE=false
DATABASE_URL=

# Optional:
JWT_SECRET=change-this-in-production
UPLOAD_DIR=uploads
